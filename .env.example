# Base de datos PostgreSQL (en producción: Supabase)
# DATABASE_URL: conexión normal (en Supabase: pooler, puerto 6543)
# DIRECT_URL: conexión directa para prisma db push / migrate (Supabase: puerto 5432)
DATABASE_URL=postgresql://usuario:password@host:6543/basededatos
#DIRECT_URL=postgresql://usuario:password@host:5432/basededatos

# Secreto para firmar los tokens JWT (obligatorio cambiarlo en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL pública del frontend (links de recuperación de contraseña)
WEB_URL=http://localhost:5173

# Puerto local (Fly.io lo define como 8080 en fly.toml)
PORT=3000
